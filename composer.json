{
  "name": "itimur/calendar-app",
  "description": "PHP mini MVC calendar with global theme, sidebar and drag&drop events.",
  "type": "project",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "App\\": "App/",
      "App\\Models\\": "App/Models/",
      "App\\Controllers\\": "App/Controllers/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },

  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
